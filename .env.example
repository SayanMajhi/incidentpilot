# Backend configuration. Copy to `.env` only if you prefer file-based config;
# every value below has a working default, so the demo runs without a .env.

# Optional Hugging Face / Qwen decision proposal engine. Leave false for the
# fully deterministic (and fastest, most repeatable) demo.
LLM_ENABLED=false
HF_TOKEN=
HF_MODEL=

# Execution environment the agent operates against: simulator (default) or
# kubernetes (a local cluster; see docs/kubernetes.md).
ENVIRONMENT=simulator

# Kubernetes mode only. The namespace is always "incidentpilot".
# K8S_CONTEXT=kind-incidentpilot
# K8S_ALLOWED_CONTEXTS=kind-incidentpilot,minikube,docker-desktop
# K8S_DEPLOYMENT=incidentpilot-demo
# K8S_ALLOWED_DEPLOYMENTS=incidentpilot-demo
# K8S_SERVICE=incidentpilot-demo
# K8S_ALLOWED_SERVICES=incidentpilot-demo
# K8S_MAX_REPLICAS=5

# Browser origins FastAPI accepts, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend configuration lives in frontend/.env.local (see frontend/.env.example):
#   VITE_API_BASE_URL=http://127.0.0.1:8000
