# IncidentPilot validates this file through backend/config.py. All values are
# safe local-demo defaults. Copy it to .env only when an override is needed.

# Runtime and browser access
ENVIRONMENT=simulator
ALLOWED_NAMESPACE=incidentpilot
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bounded controller and independent verification
MAX_REMEDIATION_ATTEMPTS=3
VERIFICATION_SAMPLES=3
VERIFICATION_INTERVAL_SECONDS=1

# Recovery SLO and elevated-evidence thresholds
RECOVERY_MAX_ERROR_RATE=0.05
RECOVERY_MAX_LATENCY_MS=200
ELEVATED_ERROR_RATE=0.10
ELEVATED_LATENCY_MS=300

# Deterministic action bounds
MIN_REPLICAS=1
MAX_REPLICAS=3

# Deterministic simulator baseline and failures
SIMULATOR_HEALTHY_ERROR_RATE=0.01
SIMULATOR_HEALTHY_LATENCY_MS=100
SIMULATOR_OUTAGE_ERROR_RATE=0.70
SIMULATOR_OUTAGE_LATENCY_MS=1000
SIMULATOR_INITIAL_VERSION=v41
SIMULATOR_BAD_DEPLOYMENT_VERSION=v42
SIMULATOR_BASELINE_LOAD_UNITS=0.6
SIMULATOR_ADAPTIVE_LOAD_UNITS=2.5
LATENCY_CHART_CEILING_MS=1200

# Optional Hugging Face/Qwen proposal engine. HF_TOKEN is deliberately blank;
# install requirements-llm.txt before enabling it. Never commit a real token.
LLM_ENABLED=false
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TIMEOUT_SECONDS=20

# Kubernetes mode (install requirements-kubernetes.txt). The Kubernetes
# adapter independently validates these targets and may narrow, never widen,
# the global replica bounds above. Leave K8S_CONTEXT blank to read the active
# kubeconfig context, which must still appear in K8S_ALLOWED_CONTEXTS.
K8S_NAMESPACE=incidentpilot
K8S_DEPLOYMENT=incidentpilot-demo
K8S_ALLOWED_DEPLOYMENTS=incidentpilot-demo
K8S_SERVICE=incidentpilot-demo
K8S_ALLOWED_SERVICES=incidentpilot-demo
K8S_SERVICE_PORT=http
K8S_PROBE_PATH=/
K8S_CONTEXT=
K8S_ALLOWED_CONTEXTS=kind-incidentpilot,minikube,docker-desktop
K8S_MIN_REPLICAS=1
K8S_MAX_REPLICAS=3
K8S_PROBE_SAMPLES=5
K8S_PROBE_TIMEOUT_SECONDS=2
K8S_LOG_TAIL_LINES=20
K8S_ROLLOUT_TIMEOUT_SECONDS=90

# Frontend configuration belongs in frontend/.env.local:
# VITE_API_BASE_URL=http://127.0.0.1:8000
